# ローカル開発用の環境変数テンプレート。コピーして .env.local を作り、値を埋めてください。
#   cp .env.example .env.local
# vercel dev はこの .env.local を自動で読み込みます。

# 必須: 各自のGoogle AIStudioで取得した自分のGemini APIキー(他人と共有しない)
# 取得先: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 任意: 使用モデル。空なら既定でgemini-2.5-flashが使われる
# 本番はgemini-3.1-flash-liteに固定済み(Vercel Production環境変数側で設定)
GEMINI_MODEL=

# 任意: 混雑時(429/503)の自動フォールバック先モデル。空なら既定でgemini-3.1-flash-liteが使われる
GEMINI_FALLBACK_MODEL=

# 必須: アプリの合言葉(入口ゲート用)。開発環境では自分で決めた任意の値でよい
APP_PASSCODE=

# 任意: Supabaseのservice_roleキー。会話ログ/フィードバックの書き込みに使う
# 未設定でもチャット自体は動作する(ログ記録だけスキップされる)。
# ログ集計作業に参加する場合のみオーナーから共有を受けて設定する
SUPABASE_SERVICE_KEY=

# 任意: 参照するデータ層。amasas(生データ直接参照) / ai(共有層) / l4(ai層+ナレッジ注入)
# 空ならamasasが既定。開発環境(vercel dev)ではPreview相当の扱いになり、
# 画面上のプルダウンからリクエストごとにモデル/データ層を切り替えて検証できる
DATA_LAYER=
